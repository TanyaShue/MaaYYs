{
  "task": [
    {
      "name": "自动斗技",
      "label": "斗技",
      "entry": "自动斗技-开始时间检查",
      "group": ["standalone"],
      "option": [
        "自动斗技-达到指定段位停止",
        "自动斗技-自定义挑战次数",
        "自动斗技-御魂预设应用方式",
        "自动斗技-战斗结算界面皮肤"
      ]
    }
  ],
  "option": {
    "自动斗技-达到指定段位停止": {
      "type": "switch",
      "label": "达到指定段位停止",
      "description": "应该不会有除了八段和名仕以外的段位目标吧",
      "default_case": "Yes",
      "cases": [
        {
          "name": "Yes",
          "label": "是",
          "pipeline_override": {
            "自动斗技-段位达标-返回庭院": {
              "enable": true
            }
          },
          "option": ["斗技段位目标"]
        },
        {
          "name": "No",
          "label": "否",
          "pipeline_override": {
            "自动斗技-段位达标-返回庭院": {
              "enable": false
            }
          }
        }
      ]
    },
    "斗技段位目标": {
      "label": "段位目标",
      "type": "select",
      "default_case": "斗技段位目标_名仕",
      "cases": [
        {
          "name": "斗技段位目标_八段",
          "label": "八段",
          "description": "可以一直投降了",
          "pipeline_override": {
            "自动斗技-段位达标-返回庭院": {
              "expected": "八段"
            }
          }
        },
        {
          "name": "斗技段位目标_九段",
          "label": "九段",
          "description": "想自己手打上名仕,对吧",
          "pipeline_override": {
            "自动斗技-段位达标-返回庭院": {
              "expected": "九段"
            }
          }
        },
        {
          "name": "斗技段位目标_名仕",
          "label": "名仕",
          "description": "你好,阵容码发一下",
          "pipeline_override": {
            "自动斗技-段位达标-返回庭院": {
              "expected": "名仕|名士"
            }
          }
        }
      ]
    },
    "自动斗技-自定义挑战次数": {
      "type": "switch",
      "label": "自定义挑战次数",
      "description": "自动斗技-自定义挑战次数",
      "default_case": "Yes",
      "cases": [
        {
          "name": "Yes",
          "label": "是",
          "option": ["自动斗技-设置指定挑战次数"]
        },
        {
          "name": "No",
          "label": "否",
          "pipeline_override": {
            "斗技-判断战斗次数是否达标": {
              "enable": false
            }
          }
        }
      ]
    },
    "自动斗技-设置指定挑战次数": {
      "type": "input",
      "label": "设置指定挑战次数",
      "description": "设置自动斗技执行的次数",
      "inputs": [
        {
          "name": "挑战次数",
          "label": "挑战次数",
          "description": "填设置自动斗技执行的次数",
          "default": "325",
          "pipeline_type": "int"
        }
      ],
      "pipeline_override": {
        "斗技-判断战斗次数是否达标": {
          "enable": true,
          "custom_recognition": "TaskCounterRecognition",
          "custom_recognition_param": {
            "target_count": "{挑战次数}"
          }
        }
      }
    },
    "自动斗技-御魂预设应用方式": {
      "type": "select",
      "label": "御魂预设应用方式",
      "description": "选择御魂预设应用方式",
      "default_case": "斗技-去式神录切换",
      "cases": [
        {
          "name": "斗技-去式神录切换",
          "label": "去式神录切换",
          "pipeline_override": {
            "斗技-从式神录装备御魂": {
              "enabled": true
            },
            "斗技-应用预设-启动层": {
              "enabled": false
            }
          },
          "option": ["自动斗技预设"]
        },
        {
          "name": "斗技-在斗技界面应用斗技御魂切换",
          "label": "直接应用斗技内阵容预设",
          "pipeline_override": {
            "斗技-应用预设-启动层": {
              "enabled": true
            }
          }
        },
        {
          "name": "斗技-不进行任何御魂应用",
          "label": "不进行任务御魂预设应用",
          "pipeline_override": {
            "斗技-应用预设-启动层": {
              "enabled": false
            }
          }
        },
        {
          "name": "斗技-通过阵容助手御魂应用",
          "label": "我是彩蛋~~还没写~~",
          "pipeline_override": {
            "斗技-应用预设-启动层": {
              "enabled": false
            }
          }
        }
      ]
    },
    "自动斗技预设": {
      "type": "input",
      "label": "斗技阵容预设",
      "description": "填写斗技需要的分组和队伍预设名称",
      "inputs": [
        {
          "name": "group_name",
          "label": "分组预设名称",
          "description": "填写分组预设名称",
          "default": "默认队伍",
          "pipeline_type": "string"
        },
        {
          "name": "team_name",
          "label": "队伍预设名称",
          "description": "填写队伍预设名称",
          "default": "默认队伍",
          "pipeline_type": "string"
        }
      ],
      "pipeline_override": {
        "自动斗技-确保打开式神录并切换御魂": {
          "custom_action_param": {
            "group_name": "{group_name}",
            "team_name": "{team_name}"
          }
        }
      }
    },
    "自动斗技-战斗结算界面皮肤": {
      "type": "select",
      "label": "结算界面皮肤",
      "description": "不是战斗主题皮肤，是结算界面皮肤，战斗主题皮肤不影响",
      "default_case": "默认",
      "cases": [
        {
          "name": "默认",
          "pipeline_override": {
            "自动斗技-胜利": {
              "template": ["斗技/胜利.png"]
            },
            "自动斗技-失败": {
              "template": ["斗技/失败.png"]
            }
          }
        },
        {
          "name": "招财纳福",
          "pipeline_override": {
            "自动斗技-胜利": {
              "template": ["斗技/胜利-招财纳福.png"]
            },
            "自动斗技-失败": {
              "template": ["斗技/失败-招财纳福.png"]
            }
          }
        }
      ]
    }
  }
}
