{
    "task": [
        {
            "name": "组队御魂-房主",
            "label": "组队御魂(房主)",
            "entry": "组队御魂-房主",
            "group": ["standalone"],
            "description": "【使用说明】在组队房间内启动即可。脚本会自动：点挑战 → 打完领奖 → 在「是否邀请队友继续进行战斗」弹窗里勾选「默认邀请队友」并点确定 → 继续循环。每完整打完一把（领完奖并邀请）计一次，达到设定挑战次数后自动关闭御魂加成并返回庭院。",
            "option": [
                "开局随机等待时间",
                "挑战次数"
            ]
        }
    ],
    "option": {
        "开局随机等待时间": {
            "type": "input",
            "label": "开局随机等待时间",
            "description": "启动任务后随机等待一段时间再开始点挑战，给队友进房留出时间（建议三秒以内）",
            "inputs": [
                {
                    "name": "最短时间",
                    "label": "最短时间（秒）",
                    "description": "填写随机等待最短时间（秒）",
                    "default": "1",
                    "pipeline_type": "string"
                },
                {
                    "name": "最长时间",
                    "label": "最长时间（秒）",
                    "description": "填写随机等待最长时间（秒）",
                    "default": "3",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "组队御魂-房主-开局等待": {
                    "custom_action_param": {
                        "min": "{最短时间}",
                        "max": "{最长时间}"
                    }
                }
            }
        },
        "挑战次数": {
            "type": "input",
            "label": "挑战次数",
            "description": "达到设定次数后自动关闭御魂加成并返回庭院",
            "inputs": [
                {
                    "name": "挑战次数",
                    "label": "挑战次数",
                    "description": "填写需要挑战的次数",
                    "default": "10",
                    "pipeline_type": "int"
                }
            ],
            "pipeline_override": {
                "组队御魂-房主-计数": {
                    "custom_action_param": {
                        "target_count": "{挑战次数}"
                    }
                }
            }
        }
    }
}
