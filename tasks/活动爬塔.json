{
    "task": [
        {
            "name": "活动爬塔-云华依言歌",
            "label": "活动爬塔-云华依言歌-神威破障",
            "description": "ooo",
            "entry": "活动爬塔-云华依言歌-开始活动爬塔任务",
            "group": ["promotion"],
            "option": [
                "云华依言歌-刷本目标",
                "云华依言歌-是否切换爬塔御魂",
                "云华依言歌-自定义爬塔随机等待"
            ]
        }
    ],
    "option": {
        "云华依言歌-刷本目标": {
            "type": "select",
            "label": "刷本目标",
            "description": "刷完哪种票",
            "default_case": "活动票",
            "cases": [
                {
                    "name": "活动票",
                    "label": "活动票",
                    "pipeline_override": {
                        "爬塔-云华依言歌-活动票花光": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "体力票",
                    "label": "体力票",
                    "pipeline_override": {
                        "爬塔-云华依言歌-体力票花光": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "指定次数",
                    "label": "指定次数",
                    "pipeline_override": {
                        "爬塔-云华依言歌-识别挑战次数是否达标": {
                            "enabled": true
                        }
                    },
                    "option": ["云华依言歌-设置爬塔次数"]
                }
            ]
        },
        "云华依言歌-是否切换爬塔御魂": {
            "type": "switch",
            "label": "是否切换御魂",
            "description": "切换爬塔御魂以及出战队伍",
            "cases": [
                {
                    "name": "Yes",
                    "label": "是",
                    "pipeline_override": {
                        "活动爬塔-云华依言歌-装备御魂": {
                            "enable":true
                        }
                    },
                    "option": ["云华依言歌-设置爬塔御魂"]
                },
                {
                    "name": "No",
                    "label": "否",
                    "pipeline_override": {
                        "活动爬塔-云华依言歌-装备御魂": {
                            "enable":false
                        }
                    }
                }
            ]
        },
        "云华依言歌-设置爬塔御魂": {
            "type": "input",
            "label": "爬塔阵容配置",
            "description": "填写爬塔时需要使用的分组和队伍名称",
            "inputs": [
                {
                    "name": "group_name",
                    "label": "分组预设名称",
                    "description": "填写分组预设名称",
                    "default": "默认分组",
                    "pipeline_type": "string"
                },
                {
                    "name": "team_name",
                    "label": "队伍预设名称",
                    "description": "填写队伍预设名称",
                    "default": "默认队伍",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "活动爬塔-云华依言歌-识别是否位于式神录": {
                    "custom_action_param": {
                        "group_name": "{group_name}",
                        "team_name": "{team_name}"
                    }
                }
            }
        },
        "云华依言歌-设置爬塔次数":{
            "type": "input",
            "label": "设置挑战次数",
            "inputs": [
                {
                    "name": "挑战次数",
                    "label": "挑战次数",
                    "default": "100",
                    "pipeline_type": "int"
                }
            ],
            "pipeline_override": {
                "爬塔-云华依言歌-识别挑战次数是否达标": {
                    "custom_recognition": "TaskCounterRecognition",
                    "custom_recognition_param": {
                        "target_count": "{挑战次数}"
                    }
                }
            }
        },
        "云华依言歌-自定义爬塔随机等待": {
            "type": "switch",
            "label": "自定义爬塔随机等待",
            "description": "是否自定义爬塔随机等待时间",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "label": "是",
                    "option": [
                        "活动爬塔-云华依言歌-开始前随机等待时间",
                        "活动爬塔-云华依言歌-打完一局后随机等待时间"
                    ]
                },
                {
                    "name": "No",
                    "label": "否"
                }
            ]
        },
        "活动爬塔-云华依言歌-开始前随机等待时间": {
            "type": "input",
            "label": "活动爬塔-云华依言歌-开始前随机等待时间",
            "inputs": [
                {
                    "name": "最短时间",
                    "label": "最短时间",
                    "description": "填写随机等待最短时间（秒）",
                    "default": "1",
                    "pipeline_type": "string"
                },
                {
                    "name": "最长时间",
                    "label": "最长时间",
                    "description": "填写随机等待最长时间（秒）",
                    "default": "5",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "活动爬塔-云华依言歌-识别挑战": {
                    "custom_action_param": {
                        "min": "{最短时间}",
                        "max": "{最长时间}"
                    }
                }
            }
        },
        "活动爬塔-云华依言歌-打完一局后随机等待时间": {
            "type": "input",
            "label": "活动爬塔-云华依言歌-打完一句后随机等待时间",
            "inputs": [
                {
                    "name": "最短时间",
                    "label": "最短时间",
                    "description": "填写随机等待的最短时间（秒）",
                    "default": "1",
                    "pipeline_type": "string"
                },
                {
                    "name": "最长时间",
                    "label": "最长时间",
                    "description": "填写随机等待的最长时间（秒）",
                    "default": "10",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "活动爬塔-云华依言歌-点击屏幕继续": {
                    "custom_action_param": {
                        "min": "{最短时间}",
                        "max": "{最长时间}"
                    }
                }
            }
        }
    }
}
