{
    "task": [
        {
            "name": "真蛇",
            "label": "真蛇",
            "entry": "真蛇",
            "group": ["standalone"],
            "option": [
                "真蛇-是否切换御魂阵容"
            ]
        }
    ],
    "option": {
        "真蛇-是否切换御魂阵容": {
            "type": "switch",
            "label": "是否切换御魂阵容",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "是",
                    "pipeline_override": {
                        "真蛇-开始装备御魂": {
                            "enabled": true
                        }
                    },
                    "option": ["真蛇-御魂阵容预设"]
                },
                {
                    "name": "No",
                    "label": "否",
                    "pipeline_override": {
                        "真蛇-开始装备御魂": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "真蛇-御魂阵容预设": {
            "type": "input",
            "label": "御魂阵容预设",
            "description": "填写自动御魂需要使用的分组和队伍预设名称",
            "inputs": [
                {
                    "name": "group_name",
                    "label": "分组预设名称",
                    "description": "填写分组预设名称",
                    "default": "默认分组",
                    "pipeline_type": "string"
                },
                {
                    "name": "team_name",
                    "label": "队伍预设名称",
                    "description": "填写队伍预设名称",
                    "default": "默认队伍",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "真蛇-在式神录装备御魂": {
                    "custom_action_param": {
                        "group_name": "{group_name}",
                        "team_name": "{team_name}"
                    }
                }
            }
        }
    }
}
