{
  "task": [
    {
      "name": "自动斗技",
      "label": "自动斗技",
      "entry": "自动斗技-开始时间检查",
      "group": ["standalone"],
      "option": [
        "自动斗技-挑战次数自定义",
        "自动斗技-达到名仕停止",
        "自动斗技-御魂预设应用方式",
        "自动斗技-战斗结算界面皮肤"
      ]
    }
  ],
  "option": {
    "自动斗技-挑战次数自定义": {
      "label": "挑战次数自定义",
      "type": "switch",
      "cases": [
        {
          "name": "Yes",
          "pipeline_override": {
            "自动斗技-胜利": {
              "next": ["自动斗技-次数记录层"]
            },
            "自动斗技-失败": {
              "next": ["自动斗技-次数记录层"]
            },
            "自动斗技-胜利-ocr识别": {
              "next": ["自动斗技-次数记录层"]
            },
            "自动斗技-失败-ocr识别": {
              "next": ["自动斗技-次数记录层"]
            }
          },
          "option": ["自动斗技-挑战次数设置处", "自动斗技-只将成功计入挑战次数"]
        },
        {
          "name": "No",
          "pipeline_override": {
            "自动斗技-胜利": {
              "next": [
                "斗技-识别是否回到斗技页面",
                "自动斗技-识别战斗结束",
                "[JumpBack]自动斗技-对局结束点击动作无通知",
                "[JumpBack]自动斗技-式神高光处理",
                "[JumpBack]通用-误触了左边聊天框"
              ]
            },
            "自动斗技-失败": {
              "next": [
                "斗技-识别是否回到斗技页面",
                "自动斗技-识别战斗结束",
                "[JumpBack]自动斗技-对局结束点击动作无通知",
                "[JumpBack]自动斗技-式神高光处理",
                "[JumpBack]通用-误触了左边聊天框"
              ]
            },
            "自动斗技-胜利-ocr识别": {
              "next": [
                "斗技-识别是否回到斗技页面",
                "自动斗技-识别战斗结束",
                "[JumpBack]自动斗技-对局结束点击动作无通知",
                "[JumpBack]自动斗技-式神高光处理",
                "[JumpBack]通用-误触了左边聊天框"
              ]
            },
            "自动斗技-失败-ocr识别": {
              "next": [
                "斗技-识别是否回到斗技页面",
                "自动斗技-识别战斗结束",
                "[JumpBack]自动斗技-对局结束点击动作无通知",
                "[JumpBack]自动斗技-式神高光处理",
                "[JumpBack]通用-误触了左边聊天框"
              ]
            }
          }
        }
      ]
    },
    "自动斗技-只将成功计入挑战次数": {
      "label": "胜利才计入次数",
      "description": "就是赢了才会计入次数,输了就不算",
      "type": "switch",
      "cases": [
        {
          "name": "Yes",
          "pipeline_override": {
            "自动斗技-胜利": {
              "next": ["自动斗技-次数记录层"]
            },
            "自动斗技-胜利-ocr识别": {
              "next": ["自动斗技-次数记录层"]
            },
            "自动斗技-失败": {
              "next": [
                "斗技-识别是否回到斗技页面",
                "自动斗技-识别战斗结束",
                "[JumpBack]自动斗技-对局结束点击动作无通知",
                "[JumpBack]自动斗技-式神高光处理",
                "[JumpBack]通用-误触了左边聊天框"
              ]
            },
            "自动斗技-失败-ocr识别": {
              "next": [
                "斗技-识别是否回到斗技页面",
                "自动斗技-识别战斗结束",
                "[JumpBack]自动斗技-对局结束点击动作无通知",
                "[JumpBack]自动斗技-式神高光处理",
                "[JumpBack]通用-误触了左边聊天框"
              ]
            }
          }
        },
        {
          "name": "No",
          "pipeline_override": {
            "自动斗技-胜利": {
              "next": ["自动斗技-次数记录层"]
            },
            "自动斗技-失败": {
              "next": ["自动斗技-次数记录层"]
            },
            "自动斗技-胜利-ocr识别": {
              "next": ["自动斗技-次数记录层"]
            },
            "自动斗技-失败-ocr识别": {
              "next": ["自动斗技-次数记录层"]
            }
          }
        }
      ]
    },
    "自动斗技-挑战次数设置处": {
      "type": "input",
      "label": "挑战次数设置处",
      "description": "填写挑战次数设置处",
      "inputs": [
        {
          "name": "自动斗技-挑战次数设置处",
          "label": "次数填写",
          "pipeline_type": "int",
          "default": "325"
        }
      ],
      "pipeline_override": {
        "自动斗技-次数记录层": {
          "max_hit": "{自动斗技-挑战次数设置处}"
        }
      }
    },
    "自动斗技-达到名仕停止": {
      "type": "switch",
      "label": "达到名仕停止",
      "description": "自动斗技-达到名仕停止",
      "default_case": "Yes",
      "cases": [
        {
          "name": "Yes",
          "label": "是",
          "pipeline_override": {
            "自动斗技-段位达标-返回庭院": {
              "enable": true
            }
          }
        },
        {
          "name": "No",
          "label": "否",
          "pipeline_override": {
            "自动斗技-段位达标-返回庭院": {
              "enable": false
            }
          }
        }
      ]
    },
    "自动斗技-御魂预设应用方式": {
      "type": "select",
      "label": "御魂预设应用方式",
      "description": "选择御魂预设应用方式",
      "default_case": "斗技-去式神录切换",
      "cases": [
        {
          "name": "斗技-去式神录切换",
          "label": "去式神录切换",
          "option": ["自动斗技预设"],
          "pipeline_override": {
            "斗技-从式神录装备御魂": {
              "enabled": true
            },
            "斗技-应用预设-启动层": {
              "enabled": false
            }
          }
        },
        {
          "name": "斗技-在斗技界面应用斗技御魂切换",
          "label": "直接应用斗技内阵容预设",
          "pipeline_override": {
            "斗技-应用预设-启动层": {
              "enabled": true
            }
          }
        },
        {
          "name": "斗技-不进行任何御魂应用",
          "label": "不进行任务御魂预设应用",
          "pipeline_override": {
            "斗技-应用预设-启动层": {
              "enabled": false
            }
          }
        },
        {
          "name": "斗技-通过阵容助手御魂应用",
          "label": "我是彩蛋~~还没写~~",
          "pipeline_override": {
            "斗技-应用预设-启动层": {
              "enabled": false
            }
          }
        }
      ]
    },
    "自动斗技预设": {
      "type": "input",
      "label": "斗技阵容预设",
      "description": "填写斗技需要的分组和队伍预设名称",
      "inputs": [
        {
          "name": "group_name",
          "label": "分组预设名称",
          "description": "填写分组预设名称",
          "default": "默认队伍",
          "pipeline_type": "string"
        },
        {
          "name": "team_name",
          "label": "队伍预设名称",
          "description": "填写队伍预设名称",
          "default": "默认队伍",
          "pipeline_type": "string"
        }
      ],
      "pipeline_override": {
        "自动斗技-确保打开式神录并切换御魂": {
          "custom_action_param": {
            "group_name": "{group_name}",
            "team_name": "{team_name}"
          }
        }
      }
    },
    "自动斗技-战斗结算界面皮肤": {
      "type": "select",
      "label": "结算界面皮肤",
      "description": "不是战斗主题皮肤，是结算界面皮肤，战斗主题皮肤不影响",
      "default_case": "默认",
      "cases": [
        {
          "name": "默认",
          "pipeline_override": {
            "自动斗技-胜利": {
              "template": ["斗技/胜利.png"]
            },
            "自动斗技-失败": {
              "template": ["斗技/失败.png"]
            }
          }
        },
        {
          "name": "招财纳福",
          "pipeline_override": {
            "自动斗技-胜利": {
              "template": ["斗技/胜利-招财纳福.png"]
            },
            "自动斗技-失败": {
              "template": ["斗技/失败-招财纳福.png"]
            }
          }
        }
      ]
    }
  }
}
